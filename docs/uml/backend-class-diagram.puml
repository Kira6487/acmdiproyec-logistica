  }

  class UnidadMedidaFormDto {
    -idUnidadMedida : Long
    -codigo : String
    -nombre : String
    -abreviatura : String
    -activo : boolean
  }

  class ProductoFormDto {
    -idProducto : Long
    -idCategoria : Long
    -idUnidadMedida : Long
    -codigo : String
    -nombre : String
    -descripcion : String
    -stockMinimo : BigDecimal
    -activo : boolean
  }

  class MotivoMovimientoFormDto {
    -idMotivoMovimiento : Long
    -codigo : String
    -nombre : String
    -tipo : String
    -descripcion : String
    -activo : boolean
  }

  class MovimientoFormDto {
    -idMotivoMovimiento : Long
    -observacion : String
