  class UsuarioFormDto {
    -idRol : Long
    -codigo : String
    -nombres : String
    -apellidos : String
    -correo : String
    -password : String
    -activo : boolean
  }

  class UsuarioResponseDto {
    -idUsuario : Long
    -codigo : String
    -nombres : String
    -apellidos : String
    -correo : String
    -rolCodigo : String
    -rolNombre : String
    -activo : boolean
  }

  class LoginDto {
    -correo : String
    -password : String
  }

  note bottom of LoginDto
    **Sin uso**: ninguna clase lo referencia.
    Se conserva en el repositorio sin eliminarlo.
  end note
}

