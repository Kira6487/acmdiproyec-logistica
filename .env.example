# Variables de entorno de conexión a Supabase para ACM Diproyec Logística.
#
# Cómo usarlas:
#   1. Copie este archivo como .env SOLO si desea una referencia local.
#   2. Defina las variables en el entorno del proceso Java. Spring Boot NO
#      carga un archivo .env de forma automática: deben estar en el entorno
#      del sistema, de la shell, del IDE o del servicio de despliegue.
#   3. Compruébelo antes de arrancar (PowerShell):
#        Get-ChildItem Env:SUPABASE_DB_*
#
# Reglas de seguridad:
#   - .env está excluido de Git (.gitignore) y nunca debe confirmarse.
#   - Nunca escriba la contraseña real en este archivo ni en ningún archivo
#     versionado, prueba, documentación, commit o registro.
#   - La contraseña se inyecta solo como variable de entorno.

# --- Parámetros no sensibles (valores predeterminados también en application.yml) ---
SUPABASE_DB_HOST=db.tqeiokeqjwwdkafsjmoi.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# --- Secreto: sustituya el marcador por el valor REAL solo en su entorno local ---
# Este proyecto es el de la conexión directa a Supabase. La contraseña debe ser
# la que obtenga desde el panel de Supabase después de la rotación.
SUPABASE_DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
