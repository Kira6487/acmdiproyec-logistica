# Variables de entorno de conexión a Supabase para ACM Diproyec Logística.
#
# Cómo se proporcionan al proceso Java:
#   Spring Boot NO carga un archivo .env de forma automática y este proyecto no
#   incluye ninguna dependencia para hacerlo. Defina estas variables en el
#   entorno real del proceso: shell, sistema operativo, IDE o servicio de
#   despliegue. Este archivo es solo una referencia de nombres y valores.
#
#   PowerShell (sesión actual):
#       Get-ChildItem Env:SUPABASE_DB_*
#   Bash:
#       env | grep SUPABASE_DB_
#
# Reglas de seguridad:
#   - .env está excluido de Git (.gitignore) y nunca debe confirmarse.
#   - Nunca escriba la contraseña real en este archivo ni en ningún archivo
#     versionado, prueba, documentación, commit, registro ni mensaje.
#   - La contraseña solo se inyecta como variable de entorno.

# ---------------------------------------------------------------------------
# 1. Destino de la conexión (forma recomendada) - valores no sensibles
#    Estos mismos valores son el predeterminado de application.yml.
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=db.tqeiokeqjwwdkafsjmoi.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# Usuario de la base de datos. Predeterminado: postgres.
SUPABASE_DB_USER=postgres

# ---------------------------------------------------------------------------
# 2. Destino de la conexión (forma alternativa, opcional)
#    Cadena JDBC completa. Si se define, tiene prioridad sobre HOST/PORT/NAME
#    y debe incluir siempre sslmode=require. No incluya usuario ni contraseña
#    dentro de esta URL.
# ---------------------------------------------------------------------------
# SUPABASE_DB_URL=jdbc:postgresql://db.tqeiokeqjwwdkafsjmoi.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# 3. Secreto - obligatorio, sin valor predeterminado
#    Sustituya el marcador por el valor real SOLO en su entorno local.
#    Si esta variable falta, la aplicación no arranca (fail-fast).
# ---------------------------------------------------------------------------
SUPABASE_DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LOCAL
